# Reference connector settings. Copy to .env and fill in. Never commit .env.

# Keys this server accepts, as key-id:secret pairs separated by commas:
#   CONNECTOR_KEYS=ck_0123456789abcdef:<43-character secret>
# The builder's "Connect your backend" step shows the pair to paste here.
# Empty means no keys: unsigned GET /v1/health still answers, every other
# request gets 401. Keys are read at start-up, so restart after a change.
# Rotation: add the new pair next to the old one, reconnect and regenerate
# your embeds, then remove the old pair. Revocation: remove the pair and
# restart.
CONNECTOR_KEYS=

# Optional: set all three to offer POST /v1/answer (any OpenAI-compatible
# /chat/completions endpoint). If any one is empty, answering is off and the
# app writes answers itself.
CONNECTOR_MODEL_BASE_URL=
CONNECTOR_MODEL=
CONNECTOR_MODEL_API_KEY=

# Optional: a mount prefix your reverse proxy forwards without stripping,
# for example /kb when the app's base URL is https://example.com/kb.
# Requests are signed over /v1/... only, so the server removes this first.
CONNECTOR_BASE_PATH=

# Port to listen on. docker-compose.yml sets 8080 itself; this is for runs
# without Docker.
PORT=8080

# Without Docker only: the Postgres connection string. docker-compose.yml
# sets DATABASE_URL itself and ignores this line.
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Optional: where the embedding model is cached. Defaults to the system temp
# directory; the Docker image uses /app/.cache.
# TRANSFORMERS_CACHE_DIR=
