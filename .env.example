# Required at runtime for chat answers. Create a key at console.groq.com.
# NOT required to build - `npm run build` must succeed without it.
GROQ_API_KEY=gsk_...

# Optional. Groq model for chat. Rate limits are per organisation and per model,
# so use one no other project in the same Groq organisation relies on.
GROQ_MODEL=openai/gpt-oss-20b

# Optional. Base URL used when generating widget embed snippets.
# Falls back to VERCEL_URL when deployed on Vercel.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional. Turns on "Connect your own database" and "Use your own model", and
# encrypts the tokens that carry connection strings, owner API keys and allowed
# sites. Generate with:
#   openssl rand -base64 32
# Must be exactly that shape (44 characters, decodes to 32 bytes). NOT needed to
# build. Missing or invalid: both features are unavailable; the demo still works,
# and allowed sites are kept with the demo widget in memory.
# Rotating it invalidates every token, saved database link, saved model and
# persistent embed.
EMBED_TOKEN_KEY=

# Optional. Set to 1 only to connect a production build to a database on
# localhost or a private network (also allows plain TCP to such hosts).
# `npm run dev` (NODE_ENV=development) already allows this.
ALLOW_PRIVATE_DB_HOSTS=

# Optional. Leave unset on public deployments. Set to 1 only for local
# development, to let an owner model address use localhost or a private or
# link-local host (for example a local mock), including plain http: to it.
# `npm run dev` (NODE_ENV=development) already allows this. Read on every call.
ALLOW_PRIVATE_MODEL_HOSTS=
