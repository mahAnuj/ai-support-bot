# Required at runtime for chat answers. Create a key at console.groq.com.
# NOT required to build - `npm run build` must succeed without it.
GROQ_API_KEY=gsk_...

# Optional. Groq model for chat. Rate limits are per organisation and per model,
# so use one no other project in the same Groq organisation relies on.
GROQ_MODEL=openai/gpt-oss-20b

# Questions each bot may ask the shared Groq model per UTC day (default 200;
# 0 or off = no limit). Bots on their own model are not counted.
# SHARED_MODEL_DAILY_LIMIT=200
# Per-site overrides: hostname=limit, comma separated; off = no limit. Applies
# only to bots locked to that site under Allowed sites.
# SHARED_MODEL_SITE_LIMITS=anujmahajan.com=off,shubhagya.com=1000

# Optional. Base URL used when generating widget embed snippets.
# Falls back to VERCEL_URL when deployed on Vercel.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional. Turns on "Connect your own database", "Use your own model" and
# "Connect your backend", and encrypts the tokens that carry connection strings,
# owner API keys, backend signing secrets and allowed sites. Generate with:
#   openssl rand -base64 32
# Must be exactly that shape (44 characters, decodes to 32 bytes). NOT needed to
# build. Missing or invalid: all three features are unavailable; the demo still
# works, and allowed sites are kept with the demo widget in memory.
# Rotating it invalidates every token, saved database link, saved model, backend
# link and persistent embed.
EMBED_TOKEN_KEY=

# Optional. Set to 1 only to connect a production build to a database on
# localhost or a private network (also allows plain TCP to such hosts).
# `npm run dev` (NODE_ENV=development) already allows this.
ALLOW_PRIVATE_DB_HOSTS=

# Optional. Leave unset on public deployments. Set to 1 only for local
# development, to let an owner model address use localhost or a private or
# link-local host (for example a local mock), including plain http: to it.
# `npm run dev` (NODE_ENV=development) already allows this. Read on every call.
ALLOW_PRIVATE_MODEL_HOSTS=

# Optional. Leave unset on public deployments. Set to 1 only for local
# development, to let "Connect your backend" use a base URL on localhost or a
# private or link-local host (for example the reference server in connector/),
# including plain http: to it. `npm run dev` (NODE_ENV=development) already
# allows this. Read on every call: a link or embed for such a host stops working
# on a server without it.
ALLOW_PRIVATE_CONNECTOR_HOSTS=

# Optional: tell the operator, on Telegram, when someone visits the builder and
# what they try (event names only: no documents, questions or connection
# details). Leave unset to turn it off; other deployments are unaffected.
# ACTIVITY_TELEGRAM_BOT_TOKEN=
# ACTIVITY_TELEGRAM_CHAT_ID=
